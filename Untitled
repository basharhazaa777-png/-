    <script>
        // إشعارات المزامنة السحابية الفورية القادمة من خلفية PHP
        <?php if(!empty($alert_message)): ?>
            alert("<?= $alert_message ?>");
            window.location.href = "?start=1&dept=<?= urlencode($current_dept) ?>";
        <?php endif; ?>

        // تفعيل خواص السحب والافلات وربطها بالـ Input الخاص بـ PHP
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const dragText = document.getElementById('dragText');

        if(dropZone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => { e.preventDefault(); dropZone.classList.add('dragover'); }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => { e.preventDefault(); dropZone.classList.remove('dragover'); }, false);
            });
            dropZone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                if(dt.files.length) { fileInput.files = dt.files; dragText.innerText = "جاهز للرفع السحابي: " + dt.files[0].name; }
            });
            fileInput.addEventListener('change', () => {
                if(fileInput.files.length) dragText.innerText = "جاهز للرفع السحابي: " + fileInput.files[0].name;
            });
        }

        // دالة البحث الفوري الخفيف داخل المتصفح
        function searchBooks() {
            let q = document.getElementById('search').value.toLowerCase();
            document.querySelectorAll('.doc-row').forEach(row => {
                let title = row.getAttribute('data-title');
                row.style.display = title.includes(q) ? 'flex' : 'none';
            });
        }

        const UI = {
            menu: (s) => {
                document.getElementById('sidebar').classList.toggle('active', s);
                document.getElementById('uiOverlay').classList.toggle('active', s);
            },
            openHubPanel: () => { UI.menu(false); document.getElementById('adminHubPanel').classList.add('active'); },
            closeHubPanel: () => document.getElementById('adminHubPanel').classList.remove('active'),
            accessGate: (gate) => {
                let pass = prompt("أدخل رمز الحماية السري لتفويض الصلاحية المباشرة:");
                if(pass === "777") {
                    <?php $_SESSION['is_admin'] = true; ?>
                    document.getElementById('gatePopup' + gate).classList.add('active');
                } else { alert("الرمز السري خاطئ!"); }
            },
            openEditPopup: (id, title, dept, level, category) => {
                const content = document.getElementById('subPopupContent');
                content.innerHTML = `
                    <form method="POST">
                        <input type="hidden" name="action" value="update_book">
                        <input type="hidden" name="id" value="${id}">
                        <h4 style="margin-bottom:14px; font-weight:900;"><i class="fas fa-edit"></i> تعديل بيانات المقرر الدراسي</h4>
                        <input type="text" name="title" class="admin-panel-input" style="color:#000; background:#fff; border:1px solid #ccc;" value="${title}" required>
                        <select name="dept" class="admin-panel-input" style="color:#000; background:#fff; border:1px solid #ccc;">
                            <option value="${dept}">${dept}</option>
                        </select>
                        <div style="display:flex; gap:12px;">
                            <button type="submit" style="flex:1; padding:12px; background:var(--success); color:white; border:none; border-radius:10px; font-weight:bold;">حفظ</button>
                            <button type="button" onclick="document.getElementById('subActionPopup').classList.remove('active')" style="flex:1; padding:12px; background:var(--danger-dark); color:white; border:none; border-radius:10px; font-weight:bold;">إلغاء</button>
                        </div>
                    </form>`;
                document.getElementById('subActionPopup').classList.add('active');
            },
            openDeletePopup: (id, title) => {
                const content = document.getElementById('subPopupContent');
                content.innerHTML = `
                    <form method="POST">
                        <input type="hidden" name="action" value="delete_book">
                        <input type="hidden" name="id" value="${id}">
                        <h4 style="margin-bottom:12px; color:var(--danger-dark); font-weight:900;"><i class="fas fa-exclamation-triangle"></i> تأكيد الحذف السحابي</h4>
                        <p style="font-size:13px; margin-bottom:18px;">هل أنت متأكد من حذف المقرّر: <b>${title}</b> نهائياً؟</p>
                        <div style="display:flex; gap:12px;">
                            <button type="submit" style="flex:1; padding:12px; background:var(--danger-dark); color:white; border:none; border-radius:10px; font-weight:bold;">نعم، إتلاف نهائي</button>
                            <button type="button" onclick="document.getElementById('subActionPopup').classList.remove('active')" style="flex:1; padding:12px; background:#7f8c8d; color:white; border:none; border-radius:10px; font-weight:bold;">تراجع</button>
                        </div>
                    </form>`;
                document.getElementById('subActionPopup').classList.add('active');
            },
            dark: () => { const isD = document.body.classList.toggle('dark-mode'); localStorage.setItem('dark', isD ? 'on' : 'off'); }
        };
        if(localStorage.getItem('dark')==='on') document.body.classList.add('dark-mode');
    </script>
</body>
</html>