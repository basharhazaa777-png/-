<?php
// index.php
require_once 'config.php';
session_start();

// إدارة الرمز السري للجلسة (الافتراضي 777 كمشروعك السابق)
if (!isset($_SESSION['bashar_pin'])) {
    $_SESSION['bashar_pin'] = "777"; 
}

$alert_message = "";

// معالجة العمليات الخلفية (POST) القادمة من نماذج التحكم
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    
    // 1. عملية رفع مقرر تعليمي جديد سحابياً (يدعم السحب والإفلات)
    if (isset($_POST['action']) && $_POST['action'] === 'upload_book') {
        $title = trim($_POST['title']);
        $dept = $_POST['dept'];
        $level = $_POST['level'];
        $sem = $_POST['sem'];
        
        if (!empty($_FILES['pdf_file']['name']) && !empty($title)) {
            $file = $_FILES['pdf_file'];
            $file_ext = pathinfo($file['name'], PATHINFO_EXTENSION);
            $tech_name = 'lib_' . time() . '.' . $file_ext;
            
            // قراءة الملف ورفعه مباشرة إلى الـ Bucket السحابي (pdfs)
            $file_data = file_get_contents($file['tmp_name']);
            $upload_endpoint = '/storage/v1/object/pdfs/' . $tech_name;
            
            $upload_headers = ['Content-Type: application/pdf'];
            $upload_res = supabase_request($upload_endpoint, 'POST', $file_data, $upload_headers);
            
            // توليد الرابط العام المباشر للملف المرفوع بناءً على رابط السحابة الخاص بك
            $public_url = SB_URL . '/storage/v1/object/public/pdfs/' . $tech_name;
            
            // إدخال سجل البيانات في جدول الكتب (books)
            $book_data = [
                'title' => $title,
                'level_name' => $level,
                'category' => $sem,
                'pdf_url' => $public_url,
                'dept' => $dept
            ];
            supabase_request('/rest/v1/books', 'POST', $book_data);
            $alert_message = "تم حفظ ورفع المقرر التعليمي بنجاح تام للمخزن السحابي!";
        }
    }
    
    // 2. عملية تحديث بيانات كتاب
    if (isset($_POST['action']) && $_POST['action'] === 'update_book') {
        $id = $_POST['id'];
        $update_data = [
            'title' => trim($_POST['title']),
            'dept' => $_POST['dept'],
            'level_name' => $_POST['level'],
            'category' => $_POST['sem']
        ];
        supabase_request('/rest/v1/books?id=eq.' . $id, 'PATCH', $update_data);
        $alert_message = "تم تحديث بيانات المقرر السحابية بنجاح!";
    }

    // 3. عملية حذف كتاب نهائياً
    if (isset($_POST['action']) && $_POST['action'] === 'delete_book') {
        $id = $_POST['id'];
        supabase_request('/rest/v1/books?id=eq.' . $id, 'DELETE');
        $alert_message = "تم حذف الملف نهائياً!";
    }

    // 4. عملية إضافة قسم أكاديمي جديد
    if (isset($_POST['action']) && $_POST['action'] === 'add_category') {
        $cat_name = trim($_POST['cat_name']);
        if (!empty($cat_name)) {
            supabase_request('/rest/v1/categories', 'POST', ['name' => $cat_name]);
            $alert_message = "تمت إضافة التخصص بنجاح للكلية!";
        }
    }
}

// جلب البيانات السحابية الحية لبناء القوائم وعرض الكتب (رندر تلقائي سريع)
$books_raw = supabase_request('/rest/v1/books?select=*&order=created_at.desc');
$books = is_array($books_raw) ? $books_raw : [];

$categories_raw = supabase_request('/rest/v1/categories?select=name');
$static_categories = ['معلم حاسوب', 'معلم لغة عربية', 'معلم لغة إنجليزية', 'معلم رياضيات', 'قسم الكيمياء', 'مراجع عامة'];
if (is_array($categories_raw)) {
    foreach ($categories_raw as $c) {
        if (!in_array($c['name'], $static_categories)) {
            $static_categories[] = $c['name'];
        }
    }
}

// تحديد القسم النشط المعروض حالياً (الافتراضي: معلم حاسوب)
$current_dept = isset($_GET['dept']) ? $_GET['dept'] : 'معلم حاسوب';
